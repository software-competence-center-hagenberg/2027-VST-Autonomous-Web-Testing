# =============================================================================
# Agent Testing Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values you need.
# The demo launchers (start-demo.ps1 / start-demo.sh) set most DEMO_*
# variables automatically; you only need to configure the provider
# credentials below for a normal local start.
# =============================================================================


# ---------------------------------------------------------------------------
# LLM Provider credentials (configure at least one)
# ---------------------------------------------------------------------------

# ---- Option 1: OpenAI-compatible endpoint (incl. self-hosted vLLM) ----
# Base URL of the OpenAI-compatible API (e.g. https://your-server/v1).
VLLM_BASE_URL=
# API key / bearer token for the endpoint.
VLLM_API_KEY=

# ---- Option 2: Azure OpenAI ----
# Full Azure OpenAI resource endpoint (e.g. https://your-resource.openai.azure.com).
AZURE_OPENAI_ENDPOINT=
# API key for the Azure resource.
AZURE_OPENAI_API_KEY=
# API version (e.g. 2024-10-21).
AZURE_OPENAI_API_VERSION=

# ---- Option 3: OpenAI ----
# Base URL (defaults to https://api.openai.com/v1 if left empty).
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI API key.
OPENAI_API_KEY=

# Models are discovered at runtime through GET /api/models and selected per
# task in POST /api/tasks. No model names are configured here.


# ---------------------------------------------------------------------------
# Demo / safety settings
# ---------------------------------------------------------------------------

# Path to a JSON file that restricts which models the UI and API accept.
# The demo launchers default this to the repository-root demo-models.json.
# Leave empty to allow all discovered models.
DEMO_ALLOWED_MODELS_FILE=

# Enable the fail-closed safety classifier that screens every new task
# before execution. Accepts: 1, true, yes, on.
# The demo launchers set this to "1" automatically.
# For local development against localhost, leave unset to skip the guard.
DEMO_SAFETY_GUARD=

# Automatically delete non-archived, non-undeletable tasks that have been in
# a terminal state (completed / failed / stopped) for longer than this many
# seconds. 0 (default) disables auto-cleanup.
# The demo launchers derive this from --task-retention-minutes /
# -TaskRetentionMinutes (minutes × 60).
DEMO_TASK_RETENTION_SECONDS=0


# ---------------------------------------------------------------------------
# Browser window / viewport settings
# ---------------------------------------------------------------------------
# These control the Chromium window that browser-use launches for each task.
# The demo launchers set them based on the host display size.

# Viewport width in pixels (default: 1920).
# DEMO_BROWSER_WIDTH=1920
# Viewport height in pixels (default: 1080).
# DEMO_BROWSER_HEIGHT=1080
# Window position — left offset in pixels (default: 0).
# Used to place the browser in the right half of the screen in visible mode.
# DEMO_BROWSER_LEFT=0
# Window position — top offset in pixels (default: 0).
# DEMO_BROWSER_TOP=0

# Run the automation browser headless (no visible window).
# Accepts: 1, true, yes, on. The demo launchers set this to "1" by default
# (streaming mode) and "0" when --visible-browser / -VisibleBrowser is passed.
# DEMO_BROWSER_HEADLESS=

# Enable the live browser preview stream (MJPEG) sent to the frontend.
# Accepts: 1, true, yes, on. The demo launchers set this to "1" in streaming
# mode and "0" in visible-browser mode.
# DEMO_BROWSER_STREAMING=


# ---------------------------------------------------------------------------
# Frontend (Vite) settings
# ---------------------------------------------------------------------------
# These are read by the Vite build / dev server, not by the Python backend.
# They are set by the demo launchers and the Dockerfile; you normally do not
# need to configure them manually.

# Show the live browser preview pane in the right half of the UI.
# Set to "true" when DEMO_BROWSER_STREAMING is enabled.
# VITE_BROWSER_STREAMING=true

# Override the API base URL the frontend uses.
# Leave empty (default) to use same-origin requests (recommended when the
# frontend proxies /api to the backend, e.g. in Docker or behind a reverse
# proxy). Set to e.g. "http://localhost:8000" for direct cross-origin access.
# VITE_API_BASE=

# Target URL for the Vite dev/preview server's /api proxy.
# Defaults to http://127.0.0.1:8000.
# VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000


# ---------------------------------------------------------------------------
# Container mode
# ---------------------------------------------------------------------------
# Set to "1" inside the Docker container. The start-demo.sh script uses this
# to skip desktop-browser detection, use the production frontend preview,
# and default the viewport to 1280×720 (override with DEMO_BROWSER_WIDTH /
# DEMO_BROWSER_HEIGHT). You do not need to set this manually.
# DEMO_CONTAINER=1
