# ------------------------
# OS / Editor Junk
# ------------------------
.DS_Store
Thumbs.db
*.swp
*.swo

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ------------------------
# Python
# ------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/

# UV-managed environments
.uv/
.uv_cache/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
coverage.xml
htmlcov/

# Environment variables
.env

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Logs
*.log

# ------------------------
# Other Common Exclusions
# ------------------------

# Local data, temporary files
*.tmp
*.temp

# Mac folder metadata
._*

# Python compiled libraries
*.pyd
*.pdb

# Pip “editable mode” symlink
src/*.egg-info/

